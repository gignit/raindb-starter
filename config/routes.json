{
  "block": [
    { "path": "/.env",   "status": 404 },
    { "path": "/.git/*", "status": 404 }
  ],
  "routes": [
    { "method": "POST", "path": "/api/ai/chat", "handler": "onHttpRequest", "streaming": true },

    { "method": "GET",    "path": "/api/*", "handler": "onHttpRequest" },
    { "method": "POST",   "path": "/api/*", "handler": "onHttpRequest" },
    { "method": "PUT",    "path": "/api/*", "handler": "onHttpRequest" },
    { "method": "PATCH",  "path": "/api/*", "handler": "onHttpRequest" },
    { "method": "DELETE", "path": "/api/*", "handler": "onHttpRequest" }
  ],
  "static": [
    { "path": "/assets/*", "publicAsset": "assets/" },
    { "path": "/*",        "publicAsset": "index.html" }
  ]
}
