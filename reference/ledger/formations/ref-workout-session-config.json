{
  "configVersion": 1,
  "minSchemaVersion": 1,
  "maxSchemaVersion": 1,
  "compatibleSchemas": [
    "v1"
  ],
  "formationId": "ref-workout-session",
  "formationType": "token",
  "scopeKey": "sessionId",
  "pathTemplate": "tokens/ref-workout-session/{{.sessionId}}.json",
  "lifecycle": {
    "expirationMode": "recycle",
    "expirationDuration": "24h",
    "autoCache": true,
    "cacheTTL": "1h"
  },
  "indexes": [
    {
      "name": "by-id",
      "template": "indexes/ref-workout-session/by-id/{{.sessionId}}/latest.json",
      "type": "pointer",
      "strategy": "write"
    }
  ]
}
