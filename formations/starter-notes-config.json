{
  "configVersion": 1,
  "formationId": "starter-notes",
  "scopeKey": "noteId",
  "autoGenId": true,
  "pathTemplate": "entities/starter-notes/{{.noteId}}/{{.yyyy}}/{{.mm}}/{{.dd}}/{{.dropletId}}.json",
  "minSchemaVersion": 1,
  "maxSchemaVersion": 1,
  "compatibleSchemas": ["v1"],
  "indexes": [
    {
      "name": "by-id",
      "template": "indexes/starter-notes/by-id/{{.noteId}}/latest.json",
      "type": "pointer",
      "strategy": "write"
    },
    {
      "name": "by-author",
      "template": "indexes/starter-notes/by-author/{{.authorName}}/{{.noteId}}/latest.json",
      "type": "pointer",
      "strategy": "write"
    },
    {
      "name": "by-update",
      "template": "indexes/starter-notes/by-update/{{.dropletId}}/latest.json",
      "type": "pointer",
      "strategy": "write",
      "descIndex": {
        "enabled": true,
        "entryTemplate": "indexes/starter-notes/by-update.desc/{{.dropletId}}/meta.json",
        "latestPointerTemplate": "indexes/starter-notes/by-update.desc/latest.json",
        "setsTemplate": "indexes/starter-notes/by-update.sets/{{.setId}}/meta.json",
        "carryFields": ["noteId", "authorName", "title"]
      }
    }
  ],
  "actions": [
    { "action": "periscope-pool", "trigger": "onDroplet", "metadata": { "tier": "stream" } }
  ],
  "queryConfig": { "enabled": true, "flattenDepth": 1, "defaultLimit": 100, "maxLimit": 1000 },
  "tierPolicy": {
    "partition": { "strategy": "formation" },
    "catalog": { "location": "periscope/{{.formationId}}/catalog" },
    "expiration": { "schedule": "daily", "snapshotRetention": "30d" },
    "tiers": {
      "stream": {
        "enabled": true,
        "source": { "type": "droplets", "index": "by-update" },
        "trigger": { "operator": "OR", "next": "*/5 * * * *", "tz": "UTC" },
        "retainInputs": true,
        "retention": { "afterSupersession": "30d" }
      },
      "river": {
        "enabled": true,
        "source": { "type": "tier", "tier": "stream" },
        "trigger": { "operator": "OR", "next": "0 */6 * * *", "tz": "UTC" },
        "retainInputs": false,
        "retention": { "afterSupersession": "30d" }
      },
      "lake": {
        "enabled": true,
        "source": { "type": "tier", "tier": "river" },
        "trigger": { "operator": "OR", "next": "0 0 * * 0", "tz": "UTC" },
        "retainInputs": false,
        "retention": { "afterSupersession": "365d" }
      }
    }
  },
  "views": {
    "defaultBehavior": { "dedup": true },
    "queryDefaults": { "autoPool": true, "window": "10s" }
  }
}
